{
  "realm": "apolla",
  "enabled": true,
  "displayName": "Apolla Work",
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "apolla-admin",
        "description": "平台管理员"
      },
      {
        "name": "apolla-member",
        "description": "普通成员"
      }
    ]
  },
  "clients": [
    {
      "clientId": "apolla-web",
      "name": "Apolla Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "apolla-web",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "tim.sun@hermess.ai",
      "firstName": "Tim",
      "lastName": "",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "apolla",
          "temporary": false
        }
      ],
      "realmRoles": [
        "apolla-admin"
      ],
      "requiredActions": []
    },
    {
      "username": "member",
      "enabled": true,
      "email": "member@corp.com",
      "firstName": "成员",
      "lastName": "",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "apolla",
          "temporary": false
        }
      ],
      "realmRoles": [
        "apolla-member"
      ],
      "requiredActions": []
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "VERIFY_EMAIL",
      "providerId": "VERIFY_EMAIL",
      "enabled": false,
      "defaultAction": false,
      "priority": 0,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "UPDATE_PROFILE",
      "providerId": "UPDATE_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 10,
