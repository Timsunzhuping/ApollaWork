{
  "name": "@apolla/server",
  "version": "0.1.0",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "prisma generate && tsc -w -p tsconfig.json & sleep 4 && node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apolla/protocol": "workspace:*",
    "@apolla/runtime": "workspace:*",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "croner": "^9.0.0",
    "dockerode": "^4.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "nanoid": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
