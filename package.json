{
  "name": "apolla-work",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r run test",
    "dev": "pnpm --parallel --filter @apolla/server --filter @apolla/web run dev",
    "eval": "pnpm --filter @apolla/eval run eval",
    "db:migrate": "pnpm --filter @apolla/server run db:migrate",
    "db:seed": "pnpm --filter @apolla/server run db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
