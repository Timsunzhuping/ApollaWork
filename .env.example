# ============ Apolla Work 配置模板 ============
# 开发：复制为 .env 即可（默认零外部依赖：SQLite + 本地文件 + mock 模型）
# 生产：见每节的「生产」注释

# ---- 数据库 ----
# 开发默认 SQLite（相对路径按 apps/server/prisma/ 解析，与 Prisma CLI 一致）
DATABASE_URL_PRISMA=file:./dev.db
# 生产：PostgreSQL（需先把 schema.prisma 的 provider 改为 postgresql 并 migrate deploy）
# DATABASE_URL_PRISMA=postgresql://apolla:PASSWORD@postgres:5432/apolla

# ---- 存储 ----
# fs = 本地目录（单机）；s3 = MinIO/S3（生产，多副本必须用 s3）
STORAGE_DRIVER=fs
STORAGE_DIR=./data/storage
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=apolla
S3_SECRET_KEY=apolla-secret
S3_BUCKET=apolla

# ---- 模型（OpenAI 兼容端点；也可在管理后台配置，DB 配置优先）----
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_DEFAULT=mock          # mock = 内置确定性模型，无需 LLM 即可跑通全链路
MODEL_FAST=                 # 快速档（可选）
MODEL_DEEP=                 # 深度档（可选）

# ---- 执行器 ----
# local = 进程内执行（仅开发！Bash 拥有宿主权限）
# docker = 每任务一沙箱容器（生产必须）
EXECUTOR=local
SANDBOX_IMAGE=apolla-sandbox:dev
MAX_CONCURRENT_TASKS=20

# ---- 队列与集群 ----
# inproc = 单副本内存队列；bullmq = 多副本共享队列（生产多副本必须）
QUEUE_DRIVER=inproc
REDIS_URL=redis://localhost:6390
CLUSTER_MODE=0              # 1 = 事件经 Redis 跨副本分发（多副本必须开）

# ---- 认证 ----
# dev = 免登录内置管理员（仅开发！）；oidc = 企业 SSO（生产必须）
AUTH_MODE=dev
OIDC_ISSUER=http://localhost:8088/realms/apolla
OIDC_CLIENT_ID=apolla-web
OIDC_AUDIENCE=apolla-web
# OIDC_JWKS_URI=            # 非 Keycloak IdP 显式指定

# ---- 主密钥（连接器/模型密钥的信封加密）；生产务必改 ----
APOLLA_MASTER_KEY=apolla-dev-insecure-master-key-change-me

# ---- 配额（0 = 不限制）----
QUOTA_ORG_MONTHLY_TOKENS=0
QUOTA_USER_MONTHLY_TOKENS=0

# ---- 数据留存（天；0 = 永久保留）----
# 事件表增长很快（一个任务约 19 条），不设留存期会导致查询变慢、备份膨胀，
# 且违反「个人数据不应无限期保留」的合规要求。
RETENTION_TASK_DAYS=180     # 任务与其事件/审批/产物
RETENTION_USAGE_DAYS=400    # 用量记录（留够跨年对账）
RETENTION_AUDIT_DAYS=730    # 审计日志（独立且最长；任务删了审计仍在）
RETENTION_CRON=             # 留空 = 不自动清理；示例 "0 3 * * *" 每天凌晨 3 点
RETENTION_TZ=Asia/Shanghai

# ---- 安全 ----
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
MAX_UPLOAD_BYTES=1073741824
ALLOWED_ORIGINS=            # 生产填明确来源，如 https://apolla.corp.com
ENABLE_HSTS=0               # 由反代统一开启更佳

# ---- 出网（默认全禁）----
WEBFETCH_ALLOWLIST=
SEARXNG_URL=

# ---- 服务 ----
SERVER_PORT=3001
SERVE_WEB=0                 # 1 = 单进程同时托管前端
WEB_PORT=5173

# ---- 可观测（留空则不外发，满足离线要求）----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=apolla-server
LOG_FORMAT=text             # 生产设 json
LOG_LEVEL=log,warn,error
