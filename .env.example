# ---- 数据库 / 基础设施（infra/compose/compose.dev.yml 默认值）----
DATABASE_URL=postgresql://apolla:apolla@localhost:5455/apolla
REDIS_URL=redis://localhost:6390
# 存储驱动：fs（本地目录，开发默认）| s3（MinIO/S3）
STORAGE_DRIVER=fs
STORAGE_DIR=./data/storage
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=apolla
S3_SECRET_KEY=apolla-secret
S3_BUCKET=apolla

# ---- 模型（一律经 OpenAI 兼容端点；生产走 LiteLLM 网关）----
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_DEFAULT=qwen3:8b
# mock = 内置确定性模型（无 LLM 环境下跑通链路/评测用）
# MODEL_DEFAULT=mock

# ---- 服务 ----
SERVER_PORT=3001
WEB_PORT=5173
# 执行器：local（子进程，开发）| docker（沙箱容器，生产）
EXECUTOR=local
SANDBOX_IMAGE=apolla-sandbox:dev
# 队列：inproc | bullmq
QUEUE_DRIVER=inproc

# ---- 认证：dev = 免登录本地管理员；oidc = 对接 Keycloak/企业 IdP ----
AUTH_MODE=dev
# oidc 模式（示例为本地 Keycloak realm）：
OIDC_ISSUER=http://localhost:8088/realms/apolla
OIDC_CLIENT_ID=apolla-web
OIDC_AUDIENCE=apolla-web
# OIDC_JWKS_URI=            # 非 Keycloak IdP 可显式指定 JWKS 端点

# ---- 模型分档路由（可选；也可在管理后台配置，优先级更高）----
MODEL_FAST=
MODEL_DEEP=

# ---- 可观测（可选，留空则不外发）----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DEBUG=0

# ---- 主密钥（连接器/模型密钥加密）；生产务必设置 ----
APOLLA_MASTER_KEY=apolla-dev-insecure-master-key-change-me

# ---- 联网工具（默认关闭出网）----
WEBFETCH_ALLOWLIST=
SEARXNG_URL=
